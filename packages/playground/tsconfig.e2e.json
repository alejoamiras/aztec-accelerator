{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    // Vite's plugin packages resolve their `vite` peer from the isolated store
    // (node_modules/.bun/vite@…) while this graph's own imports resolve the playground's
    // package-level copy — same version, two file trees, so tsc sees two declarations and
    // their private properties conflict. Force every `import "vite"` onto one copy.
    "paths": { "vite": ["./node_modules/vite"] }
  },
  "include": ["e2e", "playwright.config.ts", "vite.config.ts"],
  "exclude": []
}
