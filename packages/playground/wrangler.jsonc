{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aztec-accelerator-playground",
  "compatibility_date": "2026-09-04",
  "preview_urls": true,
  "routes": [
    {
      "pattern": "playground.aztec-accelerator.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
